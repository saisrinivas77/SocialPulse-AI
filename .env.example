# ==============================================================================
# SOCIALPULSE AI — PRODUCTION ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# Application & Server Core
PROJECT_NAME="SocialPulse AI"
ENVIRONMENT="production"
DEBUG=false
API_V1_STR="/api/v1"
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:8000"

# Development & Testing Mode Toggle
# When DEMO_MODE=true, seed demo account demo@socialpulse.ai (Password: Demo@12345)
DEMO_MODE=false

# Database Configuration (PostgreSQL / MySQL)
# SQLALCHEMY_DATABASE_URI: async SQLAlchemy driver URI
DATABASE_URL="postgresql+asyncpg://postgres:postgres_password@localhost:5432/socialpulse_ai"
DB_HOST="localhost"
DB_PORT=5432
DB_USER="postgres"
DB_PASSWORD="postgres_password"
DB_NAME="socialpulse_ai"

# JWT Authentication & Token Security
# Generate secure random secrets via `openssl rand -hex 32`
JWT_SECRET="e89f812a14b301c238fa0184b8109d94a123f81e19488a01f92e81747e90b812"
REFRESH_SECRET="c78491829e120194bc0285a9f021e8471e98d81014840e194e801048f029194e"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Fernet AES Token Encryption Key (For encrypting social OAuth tokens in DB)
# Generate key via `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
ENCRYPTION_KEY="diirruluPNUmbWfYgX4iABpCiul-CIQl0q1c0o2pPGs="

# Redis & Celery Background Sync Pipelines
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# ==============================================================================
# SYSTEM 1: USER AUTHENTICATION OAUTH PROVIDERS (IDENTITY ONLY)
# ==============================================================================

# Google Login OAuth 2.0 / OpenID Connect
GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_oauth_client_secret"

# Microsoft / Azure AD OAuth
MICROSOFT_CLIENT_ID="your_microsoft_azure_client_id"
MICROSOFT_CLIENT_SECRET="your_microsoft_azure_client_secret"

# GitHub OAuth
GITHUB_CLIENT_ID="your_github_oauth_client_id"
GITHUB_CLIENT_SECRET="your_github_oauth_client_secret"

# Apple Sign In OAuth
APPLE_CLIENT_ID="your_apple_signin_service_id"
APPLE_CLIENT_SECRET="your_apple_signin_private_key"

# LinkedIn Login OAuth
LINKEDIN_CLIENT_ID="your_linkedin_oauth_client_id"
LINKEDIN_CLIENT_SECRET="your_linkedin_oauth_client_secret"

# ==============================================================================
# SYSTEM 2: SOCIAL PLATFORM INTEGRATIONS (DATA & PUBLISHING OAUTH)
# ==============================================================================

# Meta Graph API (Instagram Business, Facebook Pages, Threads)
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"
META_WEBHOOK_VERIFY_TOKEN="your_meta_webhook_verify_token"

# X / Twitter API v2
TWITTER_CLIENT_ID="your_twitter_client_id"
TWITTER_CLIENT_SECRET="your_twitter_client_secret"
TWITTER_API_KEY="your_twitter_api_key"
TWITTER_API_SECRET="your_twitter_api_secret"
TWITTER_BEARER_TOKEN="your_twitter_bearer_token"

# TikTok Business API
TIKTOK_CLIENT_ID="your_tiktok_business_client_key"
TIKTOK_CLIENT_SECRET="your_tiktok_business_client_secret"

# YouTube Data API v3 (Google OAuth with YouTube Scopes)
YOUTUBE_API_KEY="your_youtube_data_api_key"

# Pinterest API v5
PINTEREST_CLIENT_ID="your_pinterest_app_id"
PINTEREST_CLIENT_SECRET="your_pinterest_app_secret"

# ==============================================================================
# EMAIL & NOTIFICATIONS
# ==============================================================================

# Resend API / SMTP Configuration
RESEND_API_KEY="re_123456789_your_resend_api_key"
EMAIL_FROM="SocialPulse AI <notifications@socialpulse.ai>"
SMTP_SERVER="smtp.resend.com font"
SMTP_PORT=587
SMTP_USERNAME="resend"
SMTP_PASSWORD="your_resend_api_key"

# CORS Configuration
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,https://socialpulse.ai"
