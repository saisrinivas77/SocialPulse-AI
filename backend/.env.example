# SocialPulse AI Backend Environment Configuration

# Application Mode
ENVIRONMENT=production
DEBUG=False
PROJECT_NAME="SocialPulse AI API"
VERSION="1.0.0"

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres_secure_pw@db:5432/socialpulse_prod
POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pw
POSTGRES_DB=socialpulse_prod

# Redis & Celery Configuration
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# Security & JWT Token Auth
SECRET_KEY=super-secret-production-jwt-key-2026
ENCRYPTION_KEY=Og5Bz9Qj_SMzJFYR_pd1Ogn7SXZ8CQGvoww0FsZQT30=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Generative AI Services
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# AWS Cloud Storage (S3 Media Assets)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=socialpulse-media-prod

# Social Platform OAuth 2.0 Credentials
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
INSTAGRAM_CLIENT_ID=your-instagram-client-id
INSTAGRAM_CLIENT_SECRET=your-instagram-client-secret
X_CLIENT_ID=your-x-client-id
X_CLIENT_SECRET=your-x-client-secret
