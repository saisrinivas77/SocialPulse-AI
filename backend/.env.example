# SocialPulse AI Enterprise Environment Configuration

# Application Mode
ENVIRONMENT=production
DEBUG=False
PROJECT_NAME="SocialPulse AI API"
VERSION="1.0.0"
DEMO_MODE=True
FRONTEND_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres_secure_pw@db:5432/socialpulse_prod
POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pw
POSTGRES_DB=socialpulse_prod

# Redis & Celery Configuration
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# Security, JWT & Session Management
SECRET_KEY=super-secret-production-jwt-key-2026
JWT_SECRET=super-secret-production-jwt-key-2026
REFRESH_SECRET=super-secret-refresh-key-2026
ENCRYPTION_KEY=Og5Bz9Qj_SMzJFYR_pd1Ogn7SXZ8CQGvoww0FsZQT30=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=43200

# Transactional Email Delivery (Resend / SendGrid / SMTP)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="SocialPulse AI <no-reply@socialpulse.ai>"

# Login OAuth Providers
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
APPLE_CLIENT_ID=your-apple-client-id
APPLE_CLIENT_SECRET=your-apple-client-secret
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# Social Network Platform Connections
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
TIKTOK_CLIENT_ID=your-tiktok-client-id
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
PINTEREST_CLIENT_ID=your-pinterest-client-id
PINTEREST_CLIENT_SECRET=your-pinterest-client-secret
YOUTUBE_API_KEY=your-youtube-api-key

# LLM Generative AI Services
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# AWS Cloud Storage
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=socialpulse-media-prod
